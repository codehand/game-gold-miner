{
  "name": "cat-mine-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:server-core": "vite build --config vite.server-core.config.ts",
    "dev": "vite",
    "dev:sim": "node scripts/dev-simulator.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "scan:secrets": "node scripts/scan-bundle-secrets.mjs",
    "sim:list": "serve-sim --list",
    "sim:stop": "serve-sim --kill",
    "supabase:reset": "supabase db reset",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config playwright.performance.config.ts",
    "test:prod": "playwright test --config playwright.production.config.ts",
    "verify": "npm run lint && npm run test && npm run test:e2e && npm run build && npm run scan:secrets && npm run test:prod",
    "verify:server": "node scripts/verify-server-stack.mjs",
    "verify:all": "npm run verify && npm run verify:server"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "break_infinity.js": "^2.2.0",
    "dexie": "^4.4.5",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "serve-sim": "^0.1.46",
    "supabase": "2.117.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
