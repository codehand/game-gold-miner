# Cat Mine Idle — environment template.
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored and
# must never be committed. This file holds placeholders only.
#
# The split below is a security boundary, not a naming convention:
#
#   VITE_*  Vite inlines these into the browser bundle. Everything here is
#           public the moment the game is served. Only publishable values.
#   others  Read by the Supabase CLI and by Edge Functions. These never reach
#           the client bundle, and `npm run scan:secrets` fails the build if one
#           does.
#
# Local values for a running stack come from `npx supabase status`. They are
# fixed, well-known development keys — real ones only ever live in the deployed
# project's configuration.

# ------------------------------------------------------------------ public --
# Supabase API URL. Local default: http://127.0.0.1:54321
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Safe in the browser: it carries no privileges
# beyond what row-level security grants the caller.
VITE_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------ server only --
# Service-role key. Bypasses row-level security completely and is the only
# writer of the `saves` table (Step 15). It must never appear in the client
# bundle, in this repository, in a log, or in any client-reachable artefact.
# Never give this variable a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pepper for the HMAC-SHA-256 recovery-code digest (Step 14). Held in Edge
# Function configuration and never stored in the database, so a database leak
# alone does not permit offline enumeration.
RECOVERY_CODE_PEPPER=generate-a-random-32-byte-value

# Telegram bot token used to verify `initData` server-side (Step 12). Never
# trust `initDataUnsafe`, and never expose this token to a client.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
